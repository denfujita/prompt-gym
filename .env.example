# Browser
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEMO_USER_ID=demo-user
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
TURNSTILE_SECRET_KEY=

# API and worker
PORT=4000
APP_ORIGIN=http://localhost:3000
ALLOW_DEMO_AUTH=true
OPENAI_API_KEY=
# Optional practice routes for the validated Design Arena text/code roster.
# This secret is server-side only; never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Prompt Gym
# Lets `npm run models:digest` prepare an OpenRouter-enabled deployment without loading the secret locally.
OPENROUTER_MODELS_ENABLED=false
# Maintainer-only credential used by `npm run models:sync`; never used for player inference.
DESIGN_ARENA_API_KEY=
SANDBOX_IMAGE_DIGEST=sha256:0d4949415a073a47d7580d3710016d7b393e343b596d1490b91a6ea34a905e3a
# Identical API/worker season anchor; rotate only after draining the prior season.
ARENA_SEASON_ANCHOR=2026-07-13T00:00:00.000Z
# SHA-256 printed by the deployment preparation check; must match API and worker exactly.
MODEL_DEPLOYMENT_DIGEST=
# Keep ranked play off until the separate Modal executor/verifier deployment has passed its isolation audit.
RANKED_PLAY_ENABLED=false
RANKED_ISOLATION_ATTESTATION=
DATABASE_URL=
REDIS_URL=
RUN_QUEUE_NAME=prompt-gym-runs
WORKER_CONCURRENCY=8
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=prompt-gym-events
CHALLENGE_SERVICE_URL=http://localhost:4100
CHALLENGE_SERVICE_TOKEN=local-development-token-000000
INSTANCE_ASSIGNMENT_SECRET=replace-in-production
PUBLIC_HANDLE_SECRET=replace-in-production
SAFETY_IDENTIFIER_SECRET=replace-in-production
GLOBAL_DAILY_COST_USD=100
